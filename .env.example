# docker-compose.yml uchun (to'liq stek: docker compose --profile full up -d --build)
POSTGRES_PASSWORD=callcenter

# Kamida 32 belgili tasodifiy qator. Masalan: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=28800
# HTTPS orqasida true bo'lishi shart
COOKIE_SECURE=false

TICKET_NUMBER_PREFIX=1097

# mock | ucm6510
PBX_DRIVER=mock
# mock rejimida navbatni taqlid qilish (jonli holat va ogohlantirishlarni sinash uchun)
MOCK_QUEUE_SIMULATION=true
UCM_BASE_URL=https://192.168.0.10:8089
UCM_API_USER=cdrapi
UCM_API_PASSWORD=

RECORDING_RETENTION_DAYS=90

MINIO_ROOT_USER=callcenter
MINIO_ROOT_PASSWORD=

# Navbatlar va IVR: ovozli xabarlar audio fayllari
VOICE_PROMPTS_DIR=storage/prompts

# Omnikanal (F-OMNI). Telegram bot: @BotFather tokeni. WEBHOOK_URL berilmasa long polling ishlaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Email javoblari (SMTP). SMTP_SECURE=true — 465-port (TLS), aks holda STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="1097 Call-markaz <call-center@kadastr.uz>"
# Kiruvchi xatlar: pochta serveri /api/public/email/inbound ga "X-Inbound-Secret" sarlavhasi bilan yuboradi
EMAIL_INBOUND_SECRET=
# Ishlab chiqishda "Sinov xabari" (Telegram/email taqlidi); NODE_ENV=production da doim o'chiq
OMNI_DEV_SIMULATION=true
