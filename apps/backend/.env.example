# Ma'lumotlar bazasi (docker-compose.yml dagi postgres bilan mos)
DATABASE_URL=postgresql://callcenter:callcenter@localhost:5432/callcenter?schema=public

# JWT: ishlab chiqarishda kamida 32 belgili tasodifiy qator qo'ying
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Sessiya muddati, soniya (8 soat — bir smena)
JWT_TTL_SECONDS=28800
# Ishlab chiqarishda (HTTPS) true bo'lishi shart
COOKIE_SECURE=false

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Murojaat raqami prefiksi: 1097-2026-000123
TICKET_NUMBER_PREFIX=1097

# Telefoniya drayveri: mock (UCM6510siz ishlab chiqish uchun) | ucm6510
PBX_DRIVER=mock
# mock rejimida navbatni taqlid qilish (jonli holat va ogohlantirishlarni sinash uchun)
MOCK_QUEUE_SIMULATION=true
UCM_BASE_URL=https://192.168.0.10:8089
UCM_API_USER=cdrapi
UCM_API_PASSWORD=

# Audio yozuvlarni saqlash muddati, kun (buyurtmachi talabi: 3 oy)
RECORDING_RETENTION_DAYS=90
# Yozuvlar ombori (lokal papka; NAS/MinIO drayveri keyin ulanadi)
RECORDINGS_DIR=storage/recordings

# Seed: demo foydalanuvchilar uchun boshlang'ich parol (faqat test muhiti!)
SEED_DEFAULT_PASSWORD=Kadastr-Test-2026!

# Navbatlar va IVR: ovozli xabarlar audio fayllari
VOICE_PROMPTS_DIR=storage/prompts

# Omnikanal (F-OMNI). Telegram bot: @BotFather tokeni. WEBHOOK_URL berilmasa long polling ishlaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Email javoblari (SMTP). SMTP_SECURE=true — 465-port (TLS), aks holda STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="1097 Call-markaz <call-center@kadastr.uz>"
# Kiruvchi xatlar: pochta serveri /api/public/email/inbound ga "X-Inbound-Secret" sarlavhasi bilan yuboradi
EMAIL_INBOUND_SECRET=
# Ishlab chiqishda "Sinov xabari" (Telegram/email taqlidi); NODE_ENV=production da doim o'chiq
OMNI_DEV_SIMULATION=true
