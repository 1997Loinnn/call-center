// Kadastr agentligi "Zamonaviy Call-markaz" yagona axborot tizimi
// Ma'lumotlar bazasi sxemasi (PostgreSQL 16)
//
// Batafsil tavsif va ER-diagramma: docs/database.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tuzilma ─────────────────────────────

enum OrgUnitType {
  AGENCY           // Kadastr agentligi (daraxt ildizi)
  CALL_CENTER      // Call-markaz
  CENTRAL_OFFICE   // Markaziy apparat
  DEPARTMENT       // Markaziy apparat bo'limi yoki boshqarmasi
  REGIONAL_OFFICE  // Agentlikning hududiy boshqarmasi
  CHAMBER          // Davlat kadastrlari palatasi (DKP)
  CHAMBER_REGIONAL // DKP hududiy boshqarmasi
  CHAMBER_BRANCH   // DKP tuman (shahar) filiali
  SUBORDINATE_ORG  // Tasarrufidagi tashkilot
}

model Region {
  id     Int     @id @default(autoincrement())
  soato  String  @unique @db.VarChar(10) // SOATO kodi
  nameUz String
  nameRu String?

  districts    District[]
  orgUnits     OrgUnit[]
  citizens     Citizen[]
  tickets      Ticket[]
  routingRules RoutingRule[]

  @@map("regions")
}

model District {
  id       Int     @id @default(autoincrement())
  regionId Int
  soato    String  @unique @db.VarChar(10)
  nameUz   String
  nameRu   String?

  region       Region        @relation(fields: [regionId], references: [id])
  orgUnits     OrgUnit[]
  citizens     Citizen[]
  tickets      Ticket[]
  routingRules RoutingRule[]

  @@index([regionId])
  @@map("districts")
}

model OrgUnit {
  id         Int         @id @default(autoincrement())
  parentId   Int?
  type       OrgUnitType
  code       String      @unique @db.VarChar(64) // barqaror kod, masalan "dkp.toshkent-sh"
  name       String
  shortName  String?
  // Materialized path: "/1/5/23/". Bo'linma va uning barcha quyi bo'linmalari
  // bitta "startsWith" so'rovi bilan topiladi (RBAC ko'rish doirasi shu asosda).
  path       String
  depth      Int         @default(0)
  regionId   Int?
  districtId Int?
  phone      String?
  email      String?
  address    String?
  website    String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  parent          OrgUnit?      @relation("OrgTree", fields: [parentId], references: [id])
  children        OrgUnit[]     @relation("OrgTree")
  region          Region?       @relation(fields: [regionId], references: [id])
  district        District?     @relation(fields: [districtId], references: [id])
  users           User[]
  assignedTickets Ticket[]      @relation("TicketAssignedOrgUnit")
  routingRules    RoutingRule[]
  ticketEvents    TicketEvent[]
  callCharges     CallCharge[]
  ticketShares    TicketParticipant[]
  costLimits      CostLimit[]

  @@index([parentId])
  @@index([path])
  @@map("org_units")
}

// ─────────────────────── Foydalanuvchilar va RBAC ───────────────────────

// Rolning ko'rish doirasi. Foydalanuvchida bir nechta rol bo'lsa, eng kengi olinadi.
enum DataScope {
  OWN       // faqat o'zi yaratgan yoki o'ziga biriktirilgan yozuvlar
  UNIT      // o'z bo'linmasi
  UNIT_TREE // o'z bo'linmasi va barcha quyi bo'linmalar
  ALL       // butun tizim
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique @db.VarChar(64)
  passwordHash    String
  fullName        String
  phone           String?
  email           String?
  orgUnitId       Int
  sipExtension    String?   @unique @db.VarChar(16) // UCM6510 dagi ichki raqam
  languages       String[]  @default(["uz"]) // navbat ko'nikmalari: uz, ru
  isActive        Boolean   @default(true)
  twoFactorSecret    String? // TOTP kaliti, shifrlangan (rahbariyat, supervisor, admin uchun)
  twoFactorEnabledAt DateTime? // null — 2FA yoqilmagan (kalit yaratilgan bo'lsa ham tasdiqlanmagan)
  twoFactorLastStep  Int? // oxirgi ishlatilgan TOTP qadami: bir kod ikki marta ishlatilmaydi
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orgUnit          OrgUnit             @relation(fields: [orgUnitId], references: [id])
  roles            UserRole[]
  createdTickets   Ticket[]            @relation("TicketCreatedBy")
  assignedTickets  Ticket[]            @relation("TicketAssignee")
  ticketEvents     TicketEvent[]
  attachments      Attachment[]
  calls            Call[]              @relation("CallAgent")
  statusLogs       AgentStatusLog[]
  handledCallbacks CallbackRequest[]
  blacklistEntries BlacklistedNumber[]
  callCharges      CallCharge[]
  qaGiven          QaEvaluation[]      @relation("QaEvaluator")
  qaReceived       QaEvaluation[]      @relation("QaAgent")
  articles         KnowledgeArticle[]
  conversations    Conversation[]
  messages         Message[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  assignedTasks    TicketTask[]        @relation("TaskAssignee")
  createdTasks     TicketTask[]        @relation("TaskCreatedBy")
  campaigns        Campaign[]
  campaignContacts CampaignContact[]
  alertsAcked      Alert[]             @relation("AlertAcknowledgedBy")
  alertsResolved   Alert[]             @relation("AlertResolvedBy")
  exportTemplates  ExportTemplate[]
  ticketShares     TicketParticipant[]
  queueMemberships QueueMember[]
  loginCodes       LoginCode[]
  costLimits       CostLimit[]

  @@index([orgUnitId])
  @@map("users")
}

// SMS orqali kirish kodi (bir martalik, 5 daqiqa, 5 urinish). Kodning o'zi emas, xeshi saqlanadi.
model LoginCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_codes")
}

model Role {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(64)
  name        String
  description String?
  scope       DataScope @default(OWN)
  permissions String[] // masalan: ["tickets.read", "tickets.create"] — ro'yxat: src/common/permissions.ts
  isSystem    Boolean   @default(false) // tizim rollari o'chirilmaydi
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────────── Fuqarolar ─────────────────────────────

model Citizen {
  id         Int      @id @default(autoincrement())
  phone       String   @unique @db.VarChar(20) // E.164: +998901234567
  extraPhones String[] @default([]) // qo'shimcha aloqa raqamlari (E.164)
  fullName    String?
  pinfl       String? // JShShIR — ilova darajasida shifrlanadi
  regionId    Int?
  districtId  Int?
  address     String?
  language    String?  @db.VarChar(5)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  region           Region?           @relation(fields: [regionId], references: [id])
  district         District?         @relation(fields: [districtId], references: [id])
  tickets          Ticket[]
  calls            Call[]
  conversations    Conversation[]
  campaignContacts CampaignContact[]
  smsMessages      SmsMessage[]

  @@map("citizens")
}

// ───────────────────────────── Murojaatlar ─────────────────────────────

enum TicketChannel {
  PHONE
  VOICEMAIL
  TELEGRAM
  WEBCHAT
  EMAIL
}

enum TicketType {
  INFO        // ma'lumot so'rash
  APPLICATION // ariza yoki taklif
  COMPLAINT   // shikoyat
  CORRUPTION  // korrupsiya holati haqida xabar
  GRATITUDE   // minnatdorchilik
}

// Holatlar va ruxsat etilgan o'tishlar: src/tickets/ticket-workflow.ts
enum TicketStatus {
  NEW         // Yangi
  ROUTED      // Yo'naltirildi
  IN_PROGRESS // Ijroda
  ANSWERED    // Javob tayyorlandi
  CLOSED      // Yopildi
  RETURNED    // Qaytarildi (noto'g'ri yo'naltirilgan)
}

enum TicketEventType {
  CREATED
  ROUTED
  ASSIGNED
  RETURNED
  ANSWERED
  APPROVED
  REJECTED
  REOPENED
  CLOSED
  ESCALATED
  COMMENT
}

model Category {
  id             Int     @id @default(autoincrement())
  parentId       Int?
  code           String  @unique @db.VarChar(64)
  nameUz         String
  nameRu         String?
  slaDays        Int          @default(15) // ijro muddati, kun
  isConfidential Boolean      @default(false) // masalan, korrupsiya xabarlari
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  // Mavzu operator kartasida qaysi murojaat turlarida chiqadi; bo'sh = barcha turlarda
  ticketTypes    TicketType[] @default([])

  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]         @relation("CategoryTree")
  tickets      Ticket[]
  routingRules RoutingRule[]
  articles     KnowledgeArticle[]
  ticketTopics TicketTopic[]

  @@map("categories")
}

// Yo'naltirish jadvali: toifa va hudud bo'yicha mas'ul bo'linma.
// null = "istalgan". Avval priority (kichigi oldin), keyin aniqlik hisobga olinadi.
model RoutingRule {
  id              Int     @id @default(autoincrement())
  categoryId      Int?
  regionId        Int?
  districtId      Int?
  targetOrgUnitId Int
  priority        Int     @default(100)
  isActive        Boolean @default(true)

  category      Category? @relation(fields: [categoryId], references: [id])
  region        Region?   @relation(fields: [regionId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])
  targetOrgUnit OrgUnit   @relation(fields: [targetOrgUnitId], references: [id])

  @@index([categoryId, regionId, districtId])
  @@map("routing_rules")
}

model Ticket {
  id                Int           @id @default(autoincrement())
  number            String        @unique @db.VarChar(32) // 1097-2026-000123
  channel           TicketChannel
  type              TicketType
  status            TicketStatus  @default(NEW)
  categoryId        Int?
  citizenId         Int?
  isAnonymous       Boolean       @default(false)
  isConfidential    Boolean       @default(false)
  regionId          Int?
  districtId        Int?
  subject           String
  description       String
  cadastreNumber    String?       @db.VarChar(64) // kadastr raqami
  applicationNumber String?       @db.VarChar(64) // ariza raqami
  createdById       Int? // operator; omnikanaldan kelsa null
  assignedOrgUnitId Int?
  assigneeId        Int?
  dueAt             DateTime?
  dueSoonNotifiedAt DateTime? // muddat yaqinlashgani haqida eslatma yuborilgan vaqt (F-CRM-05)
  escalatedAt       DateTime? // muddat o'tib, yuqori bo'linmaga eskalatsiya qilingan vaqt
  answer            String?
  answeredAt        DateTime?
  closedAt          DateTime?
  duplicateOfId     Int?
  // Matndagi kalit so'zlar bo'yicha belgilar (F-AI-04): corruption | threat | escalation
  aiFlags           String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id])
  citizen          Citizen?          @relation(fields: [citizenId], references: [id])
  region           Region?           @relation(fields: [regionId], references: [id])
  district         District?         @relation(fields: [districtId], references: [id])
  createdBy        User?             @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedOrgUnit  OrgUnit?          @relation("TicketAssignedOrgUnit", fields: [assignedOrgUnitId], references: [id])
  assignee         User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  duplicateOf      Ticket?           @relation("TicketDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Ticket[]          @relation("TicketDuplicates")
  events           TicketEvent[]
  attachments      Attachment[]
  calls            Call[]
  surveys          Survey[]
  conversations    Conversation[]
  tasks            TicketTask[]
  campaignContacts CampaignContact[]
  smsMessages      SmsMessage[]
  extraTopics      TicketTopic[]
  participants     TicketParticipant[]

  @@index([status, dueAt])
  @@index([assignedOrgUnitId, status])
  @@index([assigneeId, status])
  @@index([citizenId])
  @@index([createdAt])
  @@map("tickets")
}

// Murojaat raqamlari uchun yillik hisoblagich (1097-2026-000123)
model TicketCounter {
  year  Int @id
  value Int @default(0)

  @@map("ticket_counters")
}

model TicketEvent {
  id         Int             @id @default(autoincrement())
  ticketId   Int
  actorId    Int?
  type       TicketEventType
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  orgUnitId  Int? // ROUTED: qaysi bo'linmaga yuborildi
  comment    String?
  createdAt  DateTime        @default(now())

  ticket  Ticket   @relation(fields: [ticketId], references: [id])
  actor   User?    @relation(fields: [actorId], references: [id])
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  storageKey   String // MinIO obyekt kaliti
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById Int?
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  uploadedBy User?  @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("attachments")
}

// Murojaat bo'yicha ichki vazifalar ("Vazifalar" tabi): masalan, "arxivdan nusxa olish"
model TicketTask {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  title       String
  assigneeId  Int?
  dueAt       DateTime?
  completedAt DateTime?
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  assignee  User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User?  @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([ticketId])
  @@index([assigneeId, completedAt])
  @@map("ticket_tasks")
}

// Murojaatning qo'shimcha mavzulari (operator bir nechta mavzu tanlaganda). Asosiy mavzu — tickets.categoryId:
// yo'naltirish va ijro muddati u bo'yicha; hisobotlarda asosiy va qo'shimcha mavzular birga sanaladi.
model TicketTopic {
  ticketId   Int
  categoryId Int

  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([ticketId, categoryId])
  @@index([categoryId])
  @@map("ticket_topics")
}

// Ishtirokchi bo'linmalar (prototip: "Ishtirokchilar"): asosiy mas'uldan tashqari murojaat ustida ishlaydigan
// bo'linmalar. Ularning xodimlari murojaatni o'z ko'rish doirasi bo'yicha ko'radi.
model TicketParticipant {
  ticketId  Int
  orgUnitId Int
  addedById Int?
  createdAt DateTime @default(now())

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id])
  addedBy User?   @relation(fields: [addedById], references: [id])

  @@id([ticketId, orgUnitId])
  @@index([orgUnitId])
  @@map("ticket_participants")
}

// ───────────────────────────── Telefoniya ─────────────────────────────

enum CallDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CallResult {
  ANSWERED  // javob berildi
  ABANDONED // navbatda kutib, uzib qo'ydi
  NO_ANSWER
  BUSY
  FAILED
  IVR_ONLY  // IVR da yakunlandi (masalan, ariza holati avtomatik aytildi)
  VOICEMAIL // ovozli xabar qoldirildi
}

enum AgentStatus {
  READY
  ON_CALL
  WRAP_UP // qo'ng'iroqdan keyingi ish
  BREAK
  OFFLINE
}

enum CallbackStatus {
  PENDING
  DONE
  FAILED
  CANCELLED
}

model Queue {
  id                   Int     @id @default(autoincrement())
  pbxNumber            String  @unique @db.VarChar(16) // UCM6510 dagi navbat raqami
  name                 String
  description          String?
  language             String? @db.VarChar(5)
  isActive             Boolean @default(true)
  // Navbat qoidalari (F-TEL-03..05). "PBX bilan sinxronlash" orqali UCM6510 ga yuklanadi.
  strategy             String  @default("longest_idle") @db.VarChar(32) // longest_idle | ring_all | round_robin | fewest_calls | random
  maxWaitSeconds       Int     @default(120) // shundan oshsa fuqaroga qayta qo'ng'iroq taklif qilinadi
  callbackEnabled      Boolean @default(true)
  announcePosition     Boolean @default(true) // navbatdagi o'rnini eshittirish (F-TEL-04)
  announceEverySeconds Int     @default(45)
  musicOnHold          String  @default("default") @db.VarChar(64)
  wrapUpSeconds        Int     @default(15) // qo'ng'iroqdan keyingi ish vaqti
  isRestricted         Boolean @default(false) // faqat biriktirilgan operatorlar (masalan, korrupsiya xabarlari)

  calls        Call[]
  callbacks    CallbackRequest[]
  campaigns    Campaign[]
  members      QueueMember[]
  ivrOptions   IvrOption[]
  ivrFallbacks IvrMenu[]         @relation("IvrFallbackQueue")

  @@map("queues")
}

// Navbat a'zolari: til va yo'nalish ko'nikmasi. penalty 0 — asosiy, 1–3 — zaxira
// (qo'ng'iroq avval kichik penalty'li bo'sh operatorga beriladi).
model QueueMember {
  queueId   Int
  userId    Int
  penalty   Int      @default(0)
  createdAt DateTime @default(now())

  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([queueId, userId])
  @@index([userId])
  @@map("queue_members")
}

// ───────────────────────────── IVR (F-TEL-02) ─────────────────────────────

enum IvrAction {
  SUBMENU       // boshqa menyuga o'tish
  QUEUE         // navbatga ulash
  TICKET_STATUS // murojaat raqami bo'yicha holatni aytish (F-CRM-10)
  CALLBACK      // qayta qo'ng'iroq buyurtmasi
  VOICEMAIL     // ovozli xabar qoldirish — murojaat sifatida ro'yxatga olinadi
  PLAYBACK      // xabarni eshittirib, menyuga qaytish
  REPEAT        // menyuni qayta eshittirish
  HANGUP        // xayrlashib uzish
}

// Ovozli xabarlar: diktor matni va yozib olingan audio fayl (administrator panelidan almashtiriladi)
model VoicePrompt {
  id              Int      @id @default(autoincrement())
  name            String
  language        String   @default("uz") @db.VarChar(5)
  text            String // diktor o'qiydigan matn
  fileName        String?
  storageKey      String? // VOICE_PROMPTS_DIR ichidagi fayl
  mimeType        String?  @db.VarChar(64)
  sizeBytes       Int?
  updatedById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menus   IvrMenu[]   @relation("IvrMenuPrompt")
  options IvrOption[]

  @@map("voice_prompts")
}

model IvrMenu {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(64) // UCM6510 dagi IVR nomi
  name            String
  language        String?  @db.VarChar(5)
  promptId        Int?
  timeoutSeconds  Int      @default(5) // tugma bosilishini kutish
  maxRetries      Int      @default(3) // noto'g'ri tugma yoki javobsizlikdan keyin qayta eshittirish
  fallbackQueueId Int? // urinishlar tugasa: shu navbat; null — xayrlashib uzish
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prompt        VoicePrompt? @relation("IvrMenuPrompt", fields: [promptId], references: [id], onDelete: SetNull)
  fallbackQueue Queue?       @relation("IvrFallbackQueue", fields: [fallbackQueueId], references: [id], onDelete: SetNull)
  options       IvrOption[]  @relation("IvrMenuOptions")
  incoming      IvrOption[]  @relation("IvrOptionTarget")

  @@map("ivr_menus")
}

model IvrOption {
  id           Int       @id @default(autoincrement())
  menuId       Int
  digit        String    @db.VarChar(1) // 0–9, *, #
  label        String
  action       IvrAction
  queueId      Int?
  targetMenuId Int?
  promptId     Int? // PLAYBACK: eshittiriladigan xabar

  menu       IvrMenu      @relation("IvrMenuOptions", fields: [menuId], references: [id], onDelete: Cascade)
  queue      Queue?       @relation(fields: [queueId], references: [id])
  targetMenu IvrMenu?     @relation("IvrOptionTarget", fields: [targetMenuId], references: [id])
  prompt     VoicePrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@unique([menuId, digit])
  @@map("ivr_options")
}

model Call {
  id           Int           @id @default(autoincrement())
  pbxCallId    String        @unique @db.VarChar(64) // UCM uniqueid
  direction    CallDirection
  callerNumber String        @db.VarChar(32)
  calledNumber String        @db.VarChar(32)
  queueId      Int?
  agentId      Int?
  citizenId    Int?
  ticketId     Int?
  ivrPath      String? // masalan "lang:uz>menu:2"
  startedAt    DateTime
  answeredAt   DateTime?
  endedAt      DateTime?
  waitSeconds  Int           @default(0)
  talkSeconds  Int           @default(0)
  result       CallResult?
  hangupBy     String?       @db.VarChar(16) // caller | agent | system
  createdAt    DateTime      @default(now())

  queue            Queue?            @relation(fields: [queueId], references: [id])
  agent            User?             @relation("CallAgent", fields: [agentId], references: [id])
  citizen          Citizen?          @relation(fields: [citizenId], references: [id])
  ticket           Ticket?           @relation(fields: [ticketId], references: [id])
  recording        Recording?
  charge           CallCharge?
  survey           Survey?
  transcript       Transcript?
  qaEvaluations    QaEvaluation[]
  callbackRequests CallbackRequest[]
  campaignContacts CampaignContact[]

  @@index([startedAt])
  @@index([agentId, startedAt])
  @@index([callerNumber])
  @@index([ticketId])
  @@map("calls")
}

model Recording {
  id              Int       @id @default(autoincrement())
  callId          Int       @unique
  storageKey      String // MinIO obyekt kaliti
  format          String    @db.VarChar(10) // wav, opus, mp3
  sizeBytes       Int
  durationSeconds Int
  retainUntil     DateTime // saqlash muddati (3 oy) tugaydigan sana
  legalHold       Boolean   @default(false) // nizoli yozuv — avtomatik o'chirilmaydi
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  call Call @relation(fields: [callId], references: [id])

  @@index([retainUntil])
  @@map("recordings")
}

model AgentStatusLog {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    AgentStatus
  reason    String? // tanaffus sababi
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startedAt])
  @@map("agent_status_logs")
}

model CallbackRequest {
  id          Int            @id @default(autoincrement())
  phone       String         @db.VarChar(20)
  queueId     Int?
  status      CallbackStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  attempts    Int            @default(0)
  handledById Int?
  handledAt   DateTime?
  callId      Int? // qayta qo'ng'iroq natijasi

  queue     Queue? @relation(fields: [queueId], references: [id])
  handledBy User?  @relation(fields: [handledById], references: [id])
  call      Call?  @relation(fields: [callId], references: [id])

  @@index([status, requestedAt])
  @@map("callback_requests")
}

model BlacklistedNumber {
  id          Int       @id @default(autoincrement())
  phone       String    @unique @db.VarChar(20)
  reason      String
  createdById Int
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("blacklisted_numbers")
}

// ─────────────────────── Chiquvchi kampaniyalar ───────────────────────

enum CampaignType {
  CALLBACK // murojaat bo'yicha qayta aloqa
  SURVEY   // xizmat sifati so'rovnomasi
  REMINDER // eslatma (masalan, tayyor hujjatni olib ketish)
  INFORM   // xabardor qilish
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignContactStatus {
  PENDING      // navbatda
  REACHED      // bog'lanildi
  NO_ANSWER    // javob bermadi (yana urinish bor)
  BUSY         // band (yana urinish bor)
  CALL_LATER   // keyinroq qo'ng'iroq qilishni so'radi
  WRONG_NUMBER // noto'g'ri raqam
  FAILED       // urinishlar tugadi
}

model Campaign {
  id          Int            @id @default(autoincrement())
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  description String?
  script      String? // operator o'qiydigan matn
  queueId     Int? // UCM6510 dagi chiquvchi navbat
  maxAttempts Int            @default(3)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  queue     Queue?            @relation(fields: [queueId], references: [id])
  createdBy User?             @relation(fields: [createdById], references: [id])
  contacts  CampaignContact[]

  @@index([status])
  @@map("campaigns")
}

model CampaignContact {
  id            Int                   @id @default(autoincrement())
  campaignId    Int
  phone         String                @db.VarChar(20)
  fullName      String?
  citizenId     Int?
  ticketId      Int? // qayta aloqa yoki so'rovnoma qaysi murojaat bo'yicha
  status        CampaignContactStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  agentId       Int? // oxirgi qo'ng'iroq qilgan operator
  callId        Int? // oxirgi urinish qo'ng'irog'i
  resolved      String?               @db.VarChar(16) // "Masala hal bo'ldimi?": yes | partly | no
  rating        Int? // 1..5
  note          String?
  createdAt     DateTime              @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  citizen  Citizen? @relation(fields: [citizenId], references: [id])
  ticket   Ticket?  @relation(fields: [ticketId], references: [id])
  agent    User?    @relation(fields: [agentId], references: [id])
  call     Call?    @relation(fields: [callId], references: [id])

  @@unique([campaignId, phone])
  @@index([campaignId, status, nextAttemptAt])
  @@map("campaign_contacts")
}

// ─────────────────────── Billing (qo'ng'iroqlar xarajati) ───────────────────────

enum TariffDirection {
  LOCAL         // shahar
  MOBILE
  LONG_DISTANCE // shaharlararo
  INTERNATIONAL
  INBOUND       // kiruvchi 1097 trafigi
}

model Tariff {
  id             Int             @id @default(autoincrement())
  direction      TariffDirection
  prefix         String          @db.VarChar(16) // raqam prefiksi, masalan "99890"
  pricePerMinute Decimal         @db.Decimal(12, 2) // so'm
  billingStepSec Int             @default(60) // tariflash qadami, soniya
  validFrom      DateTime
  validTo        DateTime?

  charges CallCharge[]

  @@index([prefix, validFrom])
  @@map("tariffs")
}

model CallCharge {
  id           Int      @id @default(autoincrement())
  callId       Int      @unique
  tariffId     Int?
  billableSec  Int
  amount       Decimal  @db.Decimal(14, 2)
  orgUnitId    Int?
  userId       Int?
  calculatedAt DateTime @default(now())

  call    Call     @relation(fields: [callId], references: [id])
  tariff  Tariff?  @relation(fields: [tariffId], references: [id])
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([orgUnitId, calculatedAt])
  @@map("call_charges")
}

// Oylik xarajat limiti (F-BIL-05): bo'linma yoki operator uchun; chegaraga yaqinlashganda ogohlantiriladi.
model CostLimit {
  id            Int      @id @default(autoincrement())
  orgUnitId     Int?
  userId        Int?
  monthlyAmount Decimal  @db.Decimal(14, 2) // so'm
  warnPercent   Int      @default(80)
  // Shu oyda qaysi darajada xabar berilgan: 1 — ogohlantirish, 2 — limitdan oshdi
  notifiedMonth String?  @db.VarChar(7) // YYYY-MM
  notifiedLevel Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgUnitId])
  @@index([userId])
  @@map("cost_limits")
}

// ─────────────────────────── Sifat va sun'iy intellekt ───────────────────────────

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Survey {
  id        Int      @id @default(autoincrement())
  callId    Int?     @unique
  ticketId  Int?
  score     Int // 1..5
  createdAt DateTime @default(now())

  call   Call?   @relation(fields: [callId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@map("surveys")
}

model QaEvaluation {
  id          Int      @id @default(autoincrement())
  callId      Int
  evaluatorId Int
  agentId     Int
  score       Int // 0..100
  checklist   Json // baholash varaqasi bandlari
  comment     String?
  createdAt   DateTime @default(now())

  call      Call @relation(fields: [callId], references: [id])
  evaluator User @relation("QaEvaluator", fields: [evaluatorId], references: [id])
  agent     User @relation("QaAgent", fields: [agentId], references: [id])

  @@index([agentId, createdAt])
  @@map("qa_evaluations")
}

model Transcript {
  id        Int        @id @default(autoincrement())
  callId    Int        @unique
  language  String     @db.VarChar(5)
  text      String
  summary   String?
  sentiment Sentiment?
  keywords  String[]
  model     String // qaysi model bilan olingan
  createdAt DateTime   @default(now())

  call Call @relation(fields: [callId], references: [id])

  @@map("transcripts")
}

model KnowledgeArticle {
  id          Int      @id @default(autoincrement())
  categoryId  Int?
  title       String
  body        String
  isPublished Boolean  @default(false)
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category? @relation(fields: [categoryId], references: [id])
  updatedBy User?     @relation(fields: [updatedById], references: [id])

  @@map("knowledge_articles")
}

// ───────────────────────────── Omnikanal ─────────────────────────────

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

model Conversation {
  id            Int                @id @default(autoincrement())
  channel       TicketChannel
  externalId    String // Telegram chat id, email birinchi xat Message-ID si, veb-chat sessiya tokeni
  citizenId     Int?
  ticketId      Int?
  assigneeId    Int?
  status        ConversationStatus @default(OPEN)
  contactName   String? // Telegram ismi, email jo'natuvchi nomi, veb-chatda kiritilgan ism
  contactHandle String? // @username yoki email manzil
  contactPhone  String?            @db.VarChar(20) // Telegram'da tasdiqlangan yoki veb-chatda kiritilgan raqam
  subject       String? // email mavzusi
  unreadCount   Int                @default(0) // operator hali o'qimagan kiruvchi xabarlar
  lastMessageAt DateTime           @default(now())
  closedAt      DateTime?
  createdAt     DateTime           @default(now())

  citizen  Citizen?  @relation(fields: [citizenId], references: [id])
  ticket   Ticket?   @relation(fields: [ticketId], references: [id])
  assignee User?     @relation(fields: [assigneeId], references: [id])
  messages Message[]

  @@unique([channel, externalId])
  @@index([status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([citizenId])
  @@map("conversations")
}

model Message {
  id             Int              @id @default(autoincrement())
  conversationId Int
  direction      MessageDirection
  authorId       Int?
  body           String
  attachments    Json?
  externalId     String? // Telegram message_id, email Message-ID
  status         String?          @db.VarChar(16) // OUT: sent | queued | failed
  error          String?
  isAuto         Boolean          @default(false) // avtomatik javob (salomlashish, murojaat holati)
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  @@index([conversationId, sentAt])
  @@index([externalId])
  @@map("messages")
}

// ───────────────────────────── Tizim ─────────────────────────────

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    @db.VarChar(64) // ticket.assigned, ticket.due_soon, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// Fuqaroga yuborilgan SMS (F-NOT-01): murojaat raqami, natija, eslatmalar
model SmsMessage {
  id          Int       @id @default(autoincrement())
  phone       String    @db.VarChar(20)
  text        String
  template    String?   @db.VarChar(64) // settings.sms_templates dagi kalit
  status      SmsStatus @default(QUEUED)
  citizenId   Int?
  ticketId    Int?
  providerId  String?   @db.VarChar(64) // SMS shlyuzidagi xabar id
  error       String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?

  citizen Citizen? @relation(fields: [citizenId], references: [id])
  ticket  Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@map("sms_messages")
}

// ─────────────────────── Ogohlantirishlar (F-MON-03) ───────────────────────

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED // supervisor "Qabul qildim" bosdi, muammo hali bor
  RESOLVED
}

// Limitlar: ko'rsatkich chegaradan oshsa ogohlantirish avtomatik ochiladi
model AlertRule {
  id        Int           @id @default(autoincrement())
  code      String        @unique @db.VarChar(64) // queue.wait.warning, trunk.down, ...
  name      String
  metric    String        @db.VarChar(64) // tekshiriladigan ko'rsatkich
  threshold Int // unit bo'yicha qiymat
  unit      String        @db.VarChar(16) // seconds | count | percent
  severity  AlertSeverity
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  alerts Alert[]

  @@map("alert_rules")
}

model Alert {
  id               Int           @id @default(autoincrement())
  ruleId           Int?
  severity         AlertSeverity
  status           AlertStatus   @default(ACTIVE)
  message          String
  source           String // "UCM6510 · queue 6500", "NAS · /recordings"
  value            Int? // aniqlangan qiymat (qoida unit'ida)
  details          Json?
  startedAt        DateTime      @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  resolvedAt       DateTime?
  resolvedById     Int? // resolvedAt bor, resolvedById yo'q = avtomatik yopildi

  rule           AlertRule? @relation(fields: [ruleId], references: [id])
  acknowledgedBy User?      @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedBy     User?      @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, startedAt])
  @@index([startedAt])
  @@map("alerts")
}

// ─────────────────────── Eksport shablonlari (F-REP-05) ───────────────────────

enum ExportFormat {
  XLSX
  PDF
  DOCX
  CSV
}

model ExportTemplate {
  id             Int          @id @default(autoincrement())
  code           String       @unique @db.VarChar(64)
  name           String
  format         ExportFormat
  source         String       @db.VarChar(32) // daily_summary | tickets | org_units | ticket_answer | calls
  columns        String[] // jadval ustunlari yoki DOCX shablon o'zgaruvchilari
  schedule       String?      @db.VarChar(64) // cron, masalan "0 18 * * *"; null = qo'lda
  recipientRoles String[]     @default([]) // jadval bo'yicha kimga yuboriladi (rol kodlari)
  isActive       Boolean      @default(true)
  // Jadval bo'yicha oxirgi yuborish: vaqt, natija (ok | partial | error) va izoh
  lastRunAt      DateTime?
  lastRunStatus  String?      @db.VarChar(16)
  lastRunNote    String?
  createdById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("export_templates")
}

// Faqat qo'shiladi: UPDATE va DELETE ma'lumotlar bazasi triggeri bilan taqiqlangan
// (migrations/20261003000100_audit_log_append_only).
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String   @db.VarChar(64) // auth.login, ticket.view, recording.play, ...
  entityType String?  @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  ip         String?  @db.VarChar(64)
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

model Setting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedById Int?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
